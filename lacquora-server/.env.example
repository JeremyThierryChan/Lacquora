# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lacquora
DB_USER=lacquora_user
DB_PASSWORD=your_secure_password_here

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your_256bit_secret_here
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studio@lacquora.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="LACQUORA Studio <studio@lacquora.com>"
EMAIL_ADMIN=admin@lacquora.com

# ── Storage ───────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── CORS ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://lacquora.com

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
